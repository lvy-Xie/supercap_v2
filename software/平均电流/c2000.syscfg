// ADCC1 -> DMA CH1：三个 ADC 各取 RESULT0..3，完成后由 CPU 提交七路码并触发 CLA。
dma1.$name = "DMA_ADC_CAPTURE";
dma1.dmaBase = "DMA_CH1_BASE";
dma1.srcAddressInputMode = "MANUAL";
dma1.srcAddressManual = 0xB00;
dma1.destAddressInputMode = "VARIABLE";
dma1.destAddressVariable = "AdcDma_Destination";
dma1.burstSize = 4;
dma1.srcBurstStep = 1;
dma1.destBurstStep = 1;
dma1.transferSize = 3;
dma1.srcTransferStep = 29;
dma1.destTransferStep = 1;
dma1.triggerSource = "DMA_TRIGGER_ADCC1";
dma1.oneShotConfig = "DMA_CFG_ONESHOT_ENABLE";
dma1.continuousModeConfig = "DMA_CFG_CONTINUOUS_DISABLE";
dma1.databusWidthConfig = "DMA_CFG_SIZE_16BIT";
dma1.useInterrupts = true;
dma1.enableInterrupts = true;
dma1.registerInterrupts = false;
dma1.interruptMode = "DMA_INT_AT_END";
dma1.enableOverrunInterrupt = true;
dma1.enableTriggers = true;
dma1.startChannel = false;
dma1.emulationMode = "DMA_EMULATION_STOP";

// CLA Task 1：仅在 DMA 整帧提交完成后软件触发；Task 8：一次性初始化。
cla1.$name = "CLA_ADC";
cla1.trigger_CLA_TASK_1 = "CLA_TRIGGER_SOFTWARE";
cla1.enable_CLA_TASK_1 = true;
cla1.cpuint_CLA_TASK_1 = false;
cla1.enable_CLA_TASK_2 = false;
cla1.cpuint_CLA_TASK_2 = false;
cla1.enable_CLA_TASK_3 = false;
cla1.cpuint_CLA_TASK_3 = false;
cla1.enable_CLA_TASK_4 = false;
cla1.cpuint_CLA_TASK_4 = false;
cla1.enable_CLA_TASK_5 = false;
